{
  "name": "upwork-cli",
  "version": "0.2.0",
  "description": "Read-only Upwork job search and inspection CLI for agents",
  "keywords": [
    "agents",
    "cli",
    "effect",
    "jobs",
    "upwork"
  ],
  "license": "MIT",
  "author": "Anis Lazaar",
  "bin": {
    "upwork": "./src/cli.ts"
  },
  "files": [
    "src",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "upwork": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run diagnostics && bun run lint && bun run format:check && bun run test:run",
    "setup": "effect-tsgo patch --typescript --oxlint",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-rc.111",
    "effect": "^4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "^4.0.0-rc.111",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "1.78.0",
    "oxlint-plugin-effect": "^0.11.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
